---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL;
---

<Layout title="BLOG｜［ブランド名］骨組み" showBreadcrumb>
  <Fragment slot="breadcrumb">
    <div class="breadcrumb">
      <div class="wrap"><a href={base}>ホーム</a> › BLOG</div>
    </div>
  </Fragment>

  <section class="page-head">
    <div class="wrap"><h1>BLOG</h1></div>
  </section>

  <section class="blog-list">
    <div class="wrap">
      <div class="blog-list-grid">
        {
          posts.map((post) => (
            <a class="blog-list-card" href={`${base}blog/${post.id}`}>
              <div class="blog-list-thumb">
                <span class="thumb-cat">{post.data.category}</span>
                <span class="thumb-caption">{post.data.title}</span>
              </div>
              <p class="blog-list-title">{post.data.title}</p>
              <p class="blog-list-excerpt">{post.data.description}</p>
              <time class="blog-list-date">
                {post.data.pubDate.toLocaleDateString("ja-JP", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding: 56px 0 40px;
  }
  .page-head h1 {
    font-size: 30px;
    display: inline-block;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 8px;
  }

  .blog-list {
    padding: 0 0 72px;
  }
  .blog-list-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .blog-list-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
  }
  .blog-list-thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 3px;
    overflow: hidden;
    background: linear-gradient(150deg, var(--line), transparent 75%), var(--surface);
  }
  .blog-list-thumb .thumb-cat {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--band-bg);
    color: var(--band-ink);
    font-size: 13px;
    padding: 5px 10px;
    border-radius: 3px;
  }
  .blog-list-thumb .thumb-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 16px;
    background: linear-gradient(0deg, rgba(15, 17, 15, 0.72), transparent);
    color: #f5f3e9;
    font-size: 14.5px;
  }
  .blog-list-title {
    font-size: 17px;
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1.7;
  }
  .blog-list-excerpt {
    margin: 0;
    font-size: 14.5px;
    color: var(--ink-soft);
  }
  .blog-list-date {
    font-size: 13.5px;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .blog-list-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .blog-list-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
