---
import {render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import PostCard from '../../components/PostCard.astro';
import TeaPhoto from '../../components/TeaPhoto.astro';
import PageIntro from '../../components/PageIntro.astro';
import PageLinks from '../../components/PageLinks.astro';
import {themes} from '../../lib/site';
import {publishedPosts} from '../../lib/posts';
import {dateLabel} from '../../../scripts/lib/publication.mjs';
export async function getStaticPaths(){const posts=await publishedPosts();return [...themes.map(theme=>({params:{slug:theme.id},props:{theme,posts:posts.filter(p=>p.data.theme===theme.id)}})),...posts.map(post=>({params:{slug:post.id},props:{post,posts}}))];}
const {theme,post,posts}=Astro.props;const group=post?themes.find(t=>t.id===post.data.theme)!:theme;
const content=post?await render(post):null;const Content=content?.Content;
const related=post?post.data.related.map(id=>posts.find(p=>p.id===id)).filter(Boolean):[];
---
{post?<Layout title={`${post.data.title}｜カフェインレス紅茶の読みもの｜PJソクラテス`} description={post.data.description} image={post.data.heroImage} article={{datePublished:post.data.publishedAt,dateModified:post.data.updatedAt}} breadcrumbs={[{name:'紅茶の読みもの',url:'/blog/'},{name:group.title,url:`/blog/${group.id}/`},{name:post.data.title}]}><article class="narrow section prose article-reading"><p class="eyebrow">{group.title}</p><h1>{post.data.title}</h1><p class="lead">{post.data.answer}</p><p class="muted">公開 {dateLabel(post.data.publishedAt)} ・ 更新 {dateLabel(post.data.updatedAt)}</p><aside class="note"><h2>この記事について</h2><p>{post.data.scope}</p>{post.data.evidence!=='reference'&&<><h3>自分で試したこと</h3><p>条件：{post.data.testConditions}</p><p>結果：{post.data.testResult}</p></>}</aside>{post.data.heroImage&&<TeaPhoto name={post.data.heroImage} alt={post.data.heroAlt!}/>} {Content&&<Content/>}<h2>参考にした資料</h2><ul>{post.data.sources.map(s=><li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.label}</a></li>)}</ul><AuthorCard/><p><a href={`/blog/${group.id}/`}>{group.title}の記事一覧へ</a></p>{related.length>0&&<section><h2>次に読む記事</h2><div class="post-grid">{related.map(p=><PostCard post={p}/>)}</div></section>}</article></Layout>:<Layout title={theme.title+'｜カフェインレス紅茶の読みもの｜PJソクラテス'} description={theme.description} noindex={posts.length===0} breadcrumbs={[{name:'紅茶の読みもの',url:'/blog/'},{name:theme.title}]}>
<div class="subpage"><PageIntro eyebrow={'TEA JOURNAL / '+theme.number} title={theme.title} lead={theme.description} photo={theme.id==='choose'?'光を受ける茶の若葉.jpg':theme.id==='brew'?'ガラスの茶器へ紅茶を注ぐ手元.jpg':'本と紅茶のある静かな時間.jpg'} alt={theme.id==='choose'?'光を受ける茶の若葉のイメージ':theme.id==='brew'?'ガラスの茶器へ紅茶を注ぐ手元のイメージ':'本と紅茶のある時間のイメージ'}/>
<section class="wrap section theme-reading"><h2>{theme.subtitle}</h2>{posts.length>0?<div class="post-grid">{posts.map(p=><PostCard post={p}/>)}</div>:<div class="theme-empty"><h2>このテーマの記事は、準備しています。</h2><p>確認したことから、順にまとめていきます。紅茶について気になることは、ぜひお聞かせください。</p><a class="button" href="/contact/?kind=tea">紅茶について質問する</a></div>}<a class="text-link" href="/blog/">紅茶の読みものに戻る</a></section>
<PageLinks heading="一杯の向こうにある、作り手の思い。" links={[{eyebrow:'OUR STORY',title:'母から始まった物語。',description:'紅茶好きの母に、自分の好きなものを楽しむ時間があってほしい。その願いが出発点です。',url:'/story/',label:'物語を読む'},{eyebrow:'THE MAKER',title:'作り手と、いまの取り組み。',description:'好きな一杯を探す人と、日々の取り組みを紹介します。',url:'/about/',label:'作り手について読む'}]}/></div></Layout>}
