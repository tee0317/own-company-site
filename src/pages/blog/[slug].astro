---
import {render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import PostCard from '../../components/PostCard.astro';
import TeaPhoto from '../../components/TeaPhoto.astro';
import {themes} from '../../lib/site';
import {publishedPosts} from '../../lib/posts';
import {dateLabel} from '../../../scripts/lib/publication.mjs';
export async function getStaticPaths(){const posts=await publishedPosts();return [...themes.map(theme=>({params:{slug:theme.id},props:{theme,posts:posts.filter(p=>p.data.theme===theme.id)}})),...posts.map(post=>({params:{slug:post.id},props:{post,posts}}))];}
const {theme,post,posts}=Astro.props;const group=post?themes.find(t=>t.id===post.data.theme)!:theme;
const content=post?await render(post):null;const Content=content?.Content;
const related=post?post.data.related.map(id=>posts.find(p=>p.id===id)).filter(Boolean):[];
---
{post?<Layout title={`${post.data.title}｜カフェインレス紅茶の知恵袋｜PJソクラテス`} description={post.data.description} image={post.data.heroImage} article={{datePublished:post.data.publishedAt,dateModified:post.data.updatedAt}} breadcrumbs={[{name:'知恵袋',url:'/blog/'},{name:group.title,url:`/blog/${group.id}/`},{name:post.data.title}]}><article class="narrow section prose"><p class="eyebrow">{group.title}</p><h1>{post.data.title}</h1><p class="lead">{post.data.answer}</p><p class="muted">公開 {dateLabel(post.data.publishedAt)} ・ 更新 {dateLabel(post.data.updatedAt)}</p><aside class="note"><h2>この記事について</h2><p>{post.data.scope}</p>{post.data.evidence!=='reference'&&<><h3>自分で試したこと</h3><p>条件：{post.data.testConditions}</p><p>結果：{post.data.testResult}</p></>}</aside>{post.data.heroImage&&<TeaPhoto name={post.data.heroImage} alt={post.data.heroAlt!}/>} {Content&&<Content/>}<h2>参考にした資料</h2><ul>{post.data.sources.map(s=><li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.label}</a></li>)}</ul><AuthorCard/><p><a href={`/blog/${group.id}/`}>{group.title}の知恵袋へ</a></p>{related.length>0&&<section><h2>次に読む記事</h2><div class="post-grid">{related.map(p=><PostCard post={p}/>)}</div></section>}</article></Layout>:<Layout title={`${theme.title}｜カフェインレス紅茶の知恵袋｜PJソクラテス`} description={theme.description} noindex={posts.length===0} breadcrumbs={[{name:'知恵袋',url:'/blog/'},{name:theme.title}]}><div class="wrap section"><p class="eyebrow">TEA JOURNAL / {theme.number}</p><h1>{theme.title}</h1><p class="lead">{theme.description}</p>{posts.length>0?<div class="post-grid">{posts.map(p=><PostCard post={p}/>)}</div>:<p>このテーマの記事は、確認したことから順にまとめています。</p>}<a class="text-link" href="/blog/">知恵袋に戻る</a></div></Layout>}
