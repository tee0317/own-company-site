---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import PageLinks from '../components/PageLinks.astro';
import TeaPhoto from '../components/TeaPhoto.astro';
import {SITE} from '../lib/site';
---
<Layout title="作り手について｜プロジェクトソクラテス" description="佐倉・千葉を拠点に、茶葉と道具を持って伺う出張ティーソムリエ、土志田拓郎。作り手の紹介と、いまの取り組みをお伝えします。" breadcrumbs={[{name:'作り手について'}]}>
<div class="subpage">
 <PageIntro eyebrow="THE MAKER / 作り手と、いまの取り組み" title="一杯を、届けに行く人。" lead="母への感謝から始まった紅茶の時間を、今度はあなたの場所へ。茶葉と道具を持って伺い、目の前で淹れています。" photo="ガラスのポットから紅茶を注ぐ手元.jpg" alt="ガラスのポットから紅茶を注ぐ手元のイメージ"/>
 <section class="wrap section maker-profile" aria-label="作り手の紹介"><figure class="maker-image"><TeaPhoto name="番号を付けた茶葉の小瓶.jpg" alt="番号の札を付けた茶葉の小瓶が棚に並ぶ"/><figcaption>写真はイメージです。本人の写真は準備中です。</figcaption></figure><div><p class="eyebrow">PROJECT SOCRATES / 作り手</p><h2>{SITE.maker}</h2><p>{SITE.title}</p><p class="role-note">自分の活動を表すために名乗っている肩書です。</p><p>母への感謝から、カフェインレス紅茶と、家族で楽しむお茶時間を探しています。紅茶を愛する人が、その日の自分に合う一杯を考えられるように。自分で試したことと、資料から調べたことを分けて伝えます。</p><dl class="maker-facts"><dt>活動地域</dt><dd>佐倉・千葉</dd><dt>屋号</dt><dd>{SITE.tradeName}</dd><dt>活動名</dt><dd>{SITE.fullName}</dd></dl></div></section>
 <section class="subpage-band"><div class="subpage-band-photo"><TeaPhoto name="台に並べた紅茶の道具.jpg" alt="台に並べたポットとカップと茶葉の小瓶"/></div><div class="subpage-band-copy"><p class="eyebrow">IN THE MAKING / いまの取り組み</p><h2>あなたの場所で、<br/>一杯の時間を。</h2><p>お店の一角、集まりの席、教室、ご家族の集まり。茶葉と器と道具を持って伺い、その場で淹れます。カフェインを控えている方も、同じ一杯を囲めるように。</p><p>茶葉を選び、淹れ方を考え、その日の自分に合う楽しみ方を見つける。ひとつの好みを正解にせず、確認した範囲が分かる形で取り組みを伝えていきます。</p><p class="muted">写真はイメージです。</p></div></section>
 <section class="section statement-section"><div class="wrap"><div class="editorial-heading"><p class="eyebrow">LOOKING AT EACH CUP</p><h2>一杯を、<br class="mobile-break"/>三つの視点から。</h2><p>これから確かめたいことを、一つずつ。<br/>条件や感じ方の違いも、大切にしていきます。</p></div><div class="practice-grid"><div class="practice-card"><p class="eyebrow">01</p><h3>茶葉の香り</h3><p>茶葉を選ぶときの香りから、お湯を注いだとき、一口飲むときまで。どんな香りを心地よく感じるかを見ていきます。</p></div><div class="practice-card"><p class="eyebrow">02</p><h3>冷やしたときの味わい</h3><p>温かいときと冷たいときで、香りや後味はどう変わるか。アイスティーとして楽しむことを考えます。</p></div><div class="practice-card"><p class="eyebrow">03</p><h3>淹れ方による違い</h3><p>茶葉の量、お湯の温度、待つ時間。条件をそろえながら、違いを少しずつ確かめていきます。</p></div></div></div></section>
 <PageLinks heading="母への思いも、あなたの紅茶時間も。" links={[{eyebrow:'OUR STORY',title:'はじまりは、母への感謝。',description:'子育てと暮らしを支えてくれた、紅茶好きの母。家族の夏に似合う一杯を目指す理由をお伝えします。',url:'/story/',label:'はじまりの物語を読む'},{eyebrow:'LET’S TALK',title:'うちでもできる？を、気軽に。',description:'出張のご相談、紅茶について気になること。内容を確認して返信します。',url:'/contact/',label:'ご相談フォームへ'}]}/>
</div></Layout>
