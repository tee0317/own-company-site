---
import Layout from '../layouts/Layout.astro';
import TeaPhoto from '../components/TeaPhoto.astro';
import PostCard from '../components/PostCard.astro';
import {themes,SITE} from '../lib/site';
import {publishedPosts} from '../lib/posts';
const posts=await publishedPosts();
const activeThemes=themes.filter(t=>posts.some(p=>p.data.theme===t.id));
const featured=posts.filter(p=>p.data.featured).sort((a,b)=>a.data.featuredOrder-b.data.featuredOrder).slice(0,3);
---
<Layout title="カフェインを気遣う日も、好きな紅茶を。｜PJソクラテス">
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow">カフェインレス紅茶の知恵袋</p><h1>カフェインを<br/>気遣う日も、<br/>好きな紅茶を。</h1><p class="hero-intro">好きな一杯と、<br/>自分のための素敵な時間を。</p><a class="btn" href="#guide">紅茶の困りごとから探す <span aria-hidden="true">↓</span></a><p class="hero-note">母への感謝から始まった、一杯を探す記録。</p></div><figure class="hero-photo"><TeaPhoto name="紅茶をグラスに注ぐ手元.jpg" alt="グラスに注がれる琥珀色の紅茶" eager/><figcaption>紅茶のある、ひと息。</figcaption></figure></section>
<section class="story-teaser section"><div class="wrap story-inner"><p class="eyebrow">この一杯を探す理由</p><h2>母の好きな時間を、<br/>少しでも長く。</h2><div><p>子育てを支えてくれた、紅茶好きの母へ。<br/>いつも誰かのために動く母に、自分の好きなものを楽しむ時間を。<br/>その思いから、カフェインレスのアイスティーを探しています。</p><a class="text-link" href="/story/">母から始まった、この取り組み <span aria-hidden="true">→</span></a></div></div></section>
<section class="section wrap" id="guide"><div class="section-head"><p class="eyebrow">紅茶の知恵袋</p><h2>好きな紅茶を、もっと自分らしく。</h2><p class="lead">気になったことから、ひとつずつ。</p></div>{activeThemes.length?<div class="theme-grid">{activeThemes.map(t=><a class="theme-card" href={`/blog/${t.id}/`}><span class="number">{t.number}</span><h3>{t.title}</h3><p>{t.subtitle}</p><span class="arrow" aria-hidden="true">→</span></a>)}</div>:<div class="empty-state"><p>知恵袋の記事は、確認したことから順にまとめています。気になる紅茶のことがあれば、お聞かせください。</p><a class="text-link" href="/contact/?kind=tea">紅茶について質問する <span aria-hidden="true">→</span></a></div>}</section>
{featured.length>0&&<section class="section recommended"><div class="wrap"><div class="section-head"><p class="eyebrow">まずはこちらから</p><h2>おすすめの記事</h2></div><div class="post-grid">{featured.map(post=><PostCard post={post}/>)}</div><a class="text-link" href="/blog/">知恵袋の記事を読む <span aria-hidden="true">→</span></a></div></section>}
<section class="section wrap maker-section"><div class="maker-portrait"><TeaPhoto name="作り手の土志田拓郎.jpg" alt="作り手の土志田拓郎"/><span class="portrait-caption">作り手　土志田 拓郎</span></div><div><p class="eyebrow">作り手と、いまの取り組み</p><h2>家族の夏に似合う、<br/>一杯を探しています。</h2><p class="lead">母が好きな紅茶を、カフェインにも配慮しながら楽しめたら。香りと味わいを大切に、カフェインレスのアイスティーを追求しています。</p><p class="maker-title">{SITE.title}<br/><small>自分の活動を表すために名乗っている肩書です。</small></p><a class="text-link" href="/about/">作り手について <span aria-hidden="true">→</span></a></div></section>
<section class="section contact-section"><div class="wrap"><p class="eyebrow">ひとつの質問から</p><h2>紅茶のこと、お聞かせください。</h2><p class="lead">紅茶についてのご質問も、お店・団体からのご相談も。<br/>内容を確認して、返信します。</p><div class="contact-actions"><a class="btn" href="/contact/?kind=tea">紅茶について質問する <span aria-hidden="true">→</span></a><a class="btn btn-outline" href="/contact/?kind=organization">お店・団体からのご相談 <span aria-hidden="true">→</span></a></div></div></section>
</Layout>
<style>.hero{display:grid;grid-template-columns:1fr 1.08fr;gap:60px;align-items:center;padding-block:64px 76px}.hero h1{letter-spacing:.045em}.hero-intro{font-size:20px;line-height:1.8;margin-top:28px;color:var(--muted)}.hero .btn{margin-top:30px}.hero-note{font-size:13px;color:var(--muted);margin-top:20px}.hero-photo{margin:0;position:relative}.hero-photo :global(img){width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:120px 120px 3px 3px}.hero-photo figcaption{text-align:right;font-size:12px;color:var(--muted);margin-top:12px}.story-teaser{background:#e9ede3;border-block:1px solid var(--line)}.story-inner{display:grid;grid-template-columns:1fr 1.25fr;column-gap:72px}.story-inner>.eyebrow{grid-column:1/-1}.story-inner>div{padding-top:4px;font-size:17px}.story-inner .text-link{margin-top:24px}.recommended{background:var(--surface)}.maker-section{display:grid;grid-template-columns:.7fr 1fr;gap:80px;align-items:center}.maker-portrait{max-width:300px;justify-self:center}.maker-portrait :global(img){width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:3px}.portrait-caption{display:block;margin-top:16px;font-size:14px;color:var(--muted)}.maker-title{margin-top:24px;font-size:15px}.maker-title small{font-size:13px;color:var(--muted)}.contact-section{background:#e9ede3;border-top:1px solid var(--line)}.contact-actions{display:flex;gap:16px;flex-wrap:wrap;margin-top:28px}@media(max-width:800px){.hero{grid-template-columns:1fr;gap:32px;padding-block:40px}.hero h1{font-size:40px}.hero-photo :global(img){aspect-ratio:4/3;border-radius:80px 80px 3px 3px}.hero-intro{margin-top:20px}.story-inner{grid-template-columns:1fr;gap:24px}.story-inner>.eyebrow{margin:0}.maker-section{grid-template-columns:1fr;gap:32px}.maker-portrait{max-width:230px;justify-self:start}.contact-actions{flex-direction:column;align-items:stretch}.contact-actions .btn{font-size:15px}}</style>
