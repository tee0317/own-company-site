---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="プロジェクトソクラテス（PJSocrates）｜より少なく、しかしより良く" showDivider>
  <section class="hero">
    <img
      class="hero-illustration"
      src={`${base}images/hero/socrates.jpg`}
      alt=""
      aria-hidden="true"
    />
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <div class="hero-box">
        <h1>より少なく<br />しかしより良く</h1>
        <p class="sub">プロジェクトソクラテス｜PJSocrates</p>
        <p class="desc">
          DIY・工具からバイク用品、キッチンツール、スポーツ用品まで。<br />
          「本当に使えるものだけを、必要な人へ」を合言葉に、
          ひとつひとつ吟味した商品をAmazonでお届けしています。
        </p>
        <div class="hero-actions">
          <a class="btn btn-accent" href={`${base}products`}>商品一覧を見る</a>
          <a class="btn btn-outline" href="#about">ブランドについて読む</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">About us</p>
        <h2>プロジェクトソクラテスについて</h2>
      </div>
      <p class="about-body">
        「より少なく、しかしより良く」をモットーに、暮らしの中の小さな不満を解消する道具を厳選してお届けするブランドです。<br />
        派手さよりも、日々使うからこそわかる使いやすさ・丈夫さにこだわり、DIY・バイク・キッチン・アウトドアなど、暮らしのさまざまな場面に寄り添う商品をAmazonを通じて展開しています。
      </p>
    </div>
  </section>

  <section class="section" id="products">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Products for sale</p>
        <h2>販売商品</h2>
      </div>
      <div class="category-tags">
        <span class="category-tag">DIY・工具</span>
        <span class="category-tag">車＆バイク</span>
        <span class="category-tag">ホーム＆キッチン</span>
        <span class="category-tag">スポーツ＆アウトドア</span>
      </div>
      <div class="products-grid">
        <article class="product-card">
          <div class="product-thumb">
            <img src={`${base}images/products/step-drill.jpg`} alt="ステップドリル2本セット" loading="lazy" />
          </div>
          <div class="body">
            <h3>ステップドリル2本セット</h3>
            <p>奇数径＋偶数径の2本組で、1本では届かないサイズにも対応。<br />500回の耐久試験済み。</p>
            <div class="mall-links">
              <a href="https://www.amazon.co.jp/dp/B0D12HBXX8" target="_blank" rel="noopener">Amazon</a>
            </div>
          </div>
        </article>

        <article class="product-card">
          <div class="product-thumb">
            <img src={`${base}images/products/anti-fog-sheet.jpg`} alt="曇り止めシート（ヘルメット用）" loading="lazy" />
          </div>
          <div class="body">
            <h3>曇り止めシート（ヘルメット用）</h3>
            <p>シールド内側に貼るピンロックシート互換。<br />超ワイド設計で視界を広くカバー。</p>
            <div class="mall-links">
              <a href="https://www.amazon.co.jp/dp/B0FFS12KDV" target="_blank" rel="noopener">Amazon</a>
            </div>
          </div>
        </article>

        <article class="product-card">
          <div class="product-thumb">
            <img src={`${base}images/products/kuri-mukiki.jpg`} alt="栗剥き器【HAGI】" loading="lazy" />
          </div>
          <div class="body">
            <h3>栗剥き器【HAGI】</h3>
            <p>硬い鬼皮もラクにむけるハサミ型キッチンツール。<br />秋の栗仕事に。</p>
            <div class="mall-links">
              <a href="https://www.amazon.co.jp/dp/B0FMJ2QX87" target="_blank" rel="noopener">Amazon</a>
            </div>
          </div>
        </article>

        <article class="product-card">
          <div class="product-thumb">
            <img src={`${base}images/products/hula-hoop.jpg`} alt="フラフープ（ダイエット用）" loading="lazy" />
          </div>
          <div class="body">
            <h3>フラフープ（ダイエット用）</h3>
            <p>約600gの軽量・静音設計。<br />「続かなかったあなたが、初めて続けられる」一本。</p>
            <div class="mall-links">
              <a href="https://www.amazon.co.jp/dp/B0FH1H5RW1" target="_blank" rel="noopener">Amazon</a>
            </div>
          </div>
        </article>
      </div>
      <div class="section-foot">
        <a class="btn btn-outline" href={`${base}products`}>販売商品一覧はこちら</a>
      </div>
    </div>
  </section>

  <section class="section" id="blog">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Blog</p>
        <h2>ブログ</h2>
      </div>
      <div class="blog-grid">
        {
          latestPosts.map((post) => (
            <article class="blog-card">
              <div class="blog-thumb" />
              <p class="cat">{post.data.category}</p>
              <h3>
                <a href={`${base}blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <time>
                {post.data.pubDate.toLocaleDateString("ja-JP", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </article>
          ))
        }
      </div>
      <div class="section-foot">
        <a class="btn btn-outline" href={`${base}blog`}>一覧を見る</a>
      </div>
    </div>
  </section>

  <section class="section contact-section" id="contact">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Contact</p>
        <h2>お問い合わせ</h2>
      </div>
      <p class="about-body">
        商品に関するご質問・お問い合わせは、LINEにて気軽にご相談ください。
      </p>
      <div class="contact-actions">
        <a class="btn btn-accent" href="https://line.me/R/ti/p/@212unaej" target="_blank" rel="noopener">LINEで相談する</a>
      </div>
    </div>
  </section>

  <section class="section sns-section">
    <div class="wrap">
      <p class="sns-heading">SNS</p>
      <ul class="sns-grid">
        <li>
          <a href="https://www.instagram.com/pjsocrates/?hl=ja" target="_blank" rel="noopener"
            >Instagram <span>→</span></a
          >
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="company">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Company</p>
        <h2>運営会社</h2>
      </div>
      <p class="about-body">
        屋号：TSDシステム／ブランド名：プロジェクトソクラテス（PJSocrates）
      </p>
      <div class="section-foot">
        <a class="btn btn-outline" href={`${base}company`}>会社概要を見る</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* --- hero --- */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 640px;
    display: flex;
    align-items: center;
    color: #f4f2e8;
  }
  .hero-illustration {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 30%;
    z-index: 0;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 14, 26, 0.25) 0%,
      rgba(10, 14, 26, 0.1) 45%,
      var(--paper) 100%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    padding: 64px 24px;
  }
  .hero-box {
    background: rgba(15, 17, 15, 0.62);
    backdrop-filter: blur(2px);
    border-radius: 6px;
    padding: 48px clamp(24px, 5vw, 64px);
    max-width: 820px;
    text-align: center;
  }
  .hero-box h1 {
    font-size: clamp(30px, 4.4vw, 48px);
    line-height: 1.4;
    color: #f8f6ec;
  }
  .hero-box .sub {
    margin-top: 16px;
    font-size: 20px;
    color: rgba(248, 246, 236, 0.75);
  }
  .hero-box .desc {
    margin-top: 26px;
    font-size: 21px;
    color: rgba(248, 246, 236, 0.82);
  }
  .hero .btn-outline {
    border-color: rgba(248, 246, 236, 0.35);
    color: #f8f6ec;
  }
  .hero-actions {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  /* --- generic section --- */
  .section {
    padding: 84px 0;
    border-bottom: 1px solid var(--line);
  }
  .section-head {
    margin-bottom: 40px;
  }
  .section-head h2 {
    font-size: 30px;
    margin-top: 10px;
  }
  .about-body {
    max-width: 42em;
    font-size: 21px;
    color: var(--ink-soft);
  }

  /* --- セクション見出し：英語（eyebrow）を主役の大見出しに、
     日本語（h2）は本文よりやや大きい程度のサブタイトルに --- */
  .section-head .eyebrow {
    font-family: var(--font-logo);
    font-weight: 600;
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: 0;
    text-transform: none;
    color: var(--logo-ink);
  }
  .section-head h2 {
    margin-top: 6px;
    font-size: 21px;
  }

  /* --- 帯セクション（黒背景）：Products / Contact / Access --- */
  .section.is-dark {
    background: var(--band-bg);
    color: var(--band-ink);
    border-bottom-color: var(--band-line);
  }
  .section.is-dark .eyebrow {
    color: var(--band-accent);
  }
  .section.is-dark h2 {
    color: var(--band-ink);
  }
  .section.is-dark .about-body,
  .section.is-dark .desc {
    color: var(--band-ink-soft);
  }
  .section.is-dark .category-tag {
    border-color: var(--band-line);
    color: var(--band-ink-soft);
  }
  .section.is-dark .product-card {
    background: rgba(245, 243, 233, 0.04);
    border-color: var(--band-line);
  }
  .section.is-dark .product-thumb {
    background: linear-gradient(140deg, var(--band-line), transparent 70%),
      rgba(245, 243, 233, 0.03);
    color: var(--band-ink-soft);
  }
  .section.is-dark .product-card h3 {
    color: var(--band-ink);
  }
  .section.is-dark .product-card p {
    color: var(--band-ink-soft);
  }
  .section.is-dark .mall-links a {
    border-color: var(--band-line);
    color: var(--band-ink);
  }
  .section.is-dark .mall-links a:hover {
    border-color: var(--band-accent);
    color: var(--band-accent);
  }
  .section.is-dark .btn-outline {
    border-color: rgba(245, 243, 233, 0.35);
    color: var(--band-ink);
  }

  /* --- products --- */
  .category-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 36px;
  }
  .category-tag {
    font-size: 16.5px;
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
  }
  .product-card {
    background: var(--accent);
    border: 1px solid var(--band-accent);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .product-thumb {
    aspect-ratio: 4 / 3;
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: var(--ink-soft);
    letter-spacing: 0.05em;
    overflow: hidden;
  }
  .product-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .product-card .body {
    padding: 20px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .product-card h3 {
    font-size: 22px;
    font-family: var(--font-body);
    font-weight: 600;
    color: #fff;
  }
  .product-card p {
    margin: 0;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.75);
    flex: 1;
  }
  .product-card .mall-links a {
    border-color: rgba(255, 255, 255, 0.4);
    color: #fff;
  }
  .product-card .mall-links a:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  .section-foot {
    margin-top: 36px;
  }

  /* --- blog --- */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .blog-thumb {
    aspect-ratio: 16 / 10;
    background: linear-gradient(150deg, var(--line), transparent 75%), var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .blog-card .cat {
    font-size: 15.5px;
    color: var(--accent);
    letter-spacing: 0.03em;
  }
  .blog-card h3 {
    font-size: 20px;
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1.6;
  }
  .blog-card time {
    font-size: 15.5px;
    color: var(--ink-soft);
  }

  /* --- contact（黒帯・中央寄せ） --- */
  .contact-section .section-head,
  .contact-section .about-body,
  .contact-section .contact-actions {
    text-align: center;
    justify-content: center;
  }
  .contact-section .about-body {
    margin: 0 auto 24px;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* --- SNS（白帯・独立セクション） --- */
  .sns-section {
    text-align: center;
  }
  .sns-heading {
    font-family: var(--font-display);
    font-size: 26px;
    letter-spacing: 0.06em;
    margin-bottom: 32px;
  }
  .sns-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .sns-grid a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-width: 200px;
    padding: 14px 22px;
    border: 1px solid var(--accent);
    border-radius: 3px;
    text-decoration: none;
    font-size: 18px;
  }
  .sns-grid a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* --- mobile --- */
  @media (max-width: 860px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .hero {
      min-height: 520px;
    }
    .hero-inner {
      padding: 40px 20px;
    }
    .hero-box {
      padding: 32px 24px;
    }
    .section {
      padding: 56px 0;
    }
    .blog-grid {
      grid-template-columns: 1fr;
    }
    .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
    .sns-grid a {
      min-width: 0;
      flex: 1 1 45%;
    }
  }
</style>
