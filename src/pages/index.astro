---
import Layout from '../layouts/Layout.astro';
import TeaPhoto from '../components/TeaPhoto.astro';
import PostCard from '../components/PostCard.astro';
import {themes,SITE} from '../lib/site';
import {publishedPosts} from '../lib/posts';
const posts=await publishedPosts();
const activeThemes=themes.filter(t=>posts.some(p=>p.data.theme===t.id));
const featured=posts.filter(p=>p.data.featured).sort((a,b)=>a.data.featuredOrder-b.data.featuredOrder).slice(0,3);
---
<Layout title="カフェインを気遣う日も、好きな紅茶を。｜PJソクラテス">
<section class="hero">
 <div class="hero-copy">
  <p class="eyebrow">カフェインレス紅茶と、お茶時間</p>
  <h1>カフェインを<br/>気遣う日も、<br/>好きな紅茶を。</h1>

  <p class="hero-description">カフェインを気遣いながらも、お気に入りの香りと味わいを楽しめる紅茶で、自分のための、やさしい時間を。</p>
  <a class="btn" href="#guide">紅茶の困りごとから探す</a>

 </div>
 <figure class="hero-photo"><TeaPhoto name="紅茶をグラスに注ぐ手元.jpg" alt="グラスに注がれる琥珀色の紅茶" eager/><figcaption>好きな一杯と、自分のための時間。</figcaption></figure>
</section>
<section class="story-teaser">
 <div class="story-inner">
  <figure class="story-photo"><TeaPhoto name="白いカップの紅茶.jpg" alt="白いカップに入れた紅茶と、そばに置いたティーポット"/><figcaption>母の好きな紅茶から、始まりました。</figcaption></figure>
  <div class="story-copy">
   <p class="eyebrow">この一杯を探す理由</p>
   <h2>母の好きな時間を、<br/>少しでも長く。</h2>
   <p>子育てを支えてくれた、紅茶好きの母へ。いつも誰かのために動く母に、自分の好きなものを楽しむ時間があってほしい。</p>
   <p>その思いから、家族の夏に似合うカフェインレスのアイスティーを探しています。</p>
   <a class="text-link" href="/story/">母から始まった、この取り組み</a>
  </div>
 </div>
</section>
<section class="section journal-section" id="guide">
 <div class="wrap">
  <div class="section-head"><p class="eyebrow">TEA JOURNAL / 紅茶の読みもの</p><h2>好きな紅茶を、<br class="mobile-break"/>もっと自分らしく。</h2><p class="lead">自分に合う一杯を選ぶこと。おいしく淹れること。お茶のある時間を楽しむこと。<br class="desktop-break"/>気になったことを、ひとつずつ確かめる場所です。</p></div>
  {activeThemes.length>0?<div class="theme-grid">{activeThemes.map(t=><a class="theme-card" href={`/blog/${t.id}/`}><span class="number">{t.number}</span><h3>{t.title}</h3><p>{t.description}</p><span class="theme-action">このテーマの記事を読む</span></a>)}</div>:<div class="empty-state"><h3>確かめたことを、きちんと言葉に。</h3><p>紅茶の表示や味わい、淹れ方について、自分で試したことと資料から調べたことを分けながら、記事を準備しています。</p><p>「カフェインレスでも、好きな味は見つかる？」「アイスティーをおいしく淹れたい」。そんな気になることがあれば、ぜひお聞かせください。</p><a class="btn btn-outline" href="/contact/?kind=tea">紅茶について質問する</a></div>}
 </div>
</section>
{featured.length>0&&<section class="section recommended"><div class="wrap"><div class="section-head"><p class="eyebrow">SELECTED JOURNAL</p><h2>おすすめの記事</h2><p class="lead">好きな紅茶との付き合い方を考える、最初の読みものに。</p></div><div class="post-grid">{featured.map(post=><PostCard post={post}/>)}</div><a class="text-link" href="/blog/">紅茶の記事を読む</a></div></section>}
<section class="maker-section">
 <div class="maker-inner">
  <div class="maker-copy"><p class="eyebrow">作り手と、いまの取り組み</p><h2>家族の夏に似合う、<br/>一杯を探しています。</h2><p>母が好きな紅茶を、カフェインにも配慮しながら楽しめたら。目指しているのは、香りと味わいを大切にした、すっきり楽しめるアイスティーです。</p><p>茶葉の選び方や淹れ方で、一杯はどう変わるのか。自分で確かめた範囲を伝えながら、同じように紅茶を愛する方と、お茶時間の楽しみを分かち合いたいと考えています。</p><p class="maker-name">{SITE.maker}</p><p class="maker-title">{SITE.title.split('・').map((part,index)=><span class="title-part">{index>0?'・':''}{part}</span>)}</p><p class="title-explanation">自分の活動を表すために名乗っている肩書です。</p><p class="maker-location">佐倉・千葉を拠点に</p><a class="text-link" href="/about/">作り手について</a></div>
  <div class="maker-profile"><TeaPhoto name="作り手の土志田拓郎.jpg" alt="作り手の土志田拓郎"/></div>
 </div>
</section>
<section class="section contact-section"><div class="wrap"><p class="eyebrow">LET'S TALK / ひとつの質問から</p><h2>あなたの紅茶時間を、<br class="mobile-break"/>聞かせてください。</h2><p class="lead">いつもの一杯について気になること、試してみたい淹れ方、お茶時間の楽しみ方。<br class="desktop-break"/>紅茶の質問も、お店・団体からのご相談も、内容を確認して返信します。</p><div class="contact-actions"><a class="btn" href="/contact/?kind=tea">紅茶について質問する</a><a class="btn btn-outline" href="/contact/?kind=organization">お店・団体からのご相談</a></div></div></section>
</Layout>
<style>
.hero,.story-inner,.maker-inner{display:grid;grid-template-columns:1.07fr 1fr;max-width:1600px;margin-inline:auto}
.hero{background:var(--paper)}.hero-copy{grid-column:2;grid-row:1;padding:48px clamp(32px,5.8vw,88px);align-self:center;min-width:0}.hero .eyebrow{font-size:.875rem;margin-bottom:20px;letter-spacing:.09em}.hero h1{font-size:clamp(2rem,4.3vw,3.625rem);line-height:1.48;letter-spacing:.035em}.hero-description{font-size:1.125rem;color:var(--muted);margin-top:24px;max-width:27em}.hero .btn{margin-top:28px;min-width:280px;font-family:var(--serif);letter-spacing:.04em}
.hero-photo{grid-column:1;grid-row:1;margin:0;min-width:0;position:relative;min-height:520px}.hero-photo :global(picture){position:absolute;inset:0;display:block}.hero-photo :global(img){width:100%;height:100%;object-fit:cover;object-position:center 64%}.hero-photo figcaption{display:none}
.story-teaser{border-block:2px solid var(--white);background:var(--surface)}.story-inner{grid-template-columns:1fr 1.22fr}.story-copy{grid-column:1;grid-row:1;padding:40px clamp(32px,5.5vw,80px)}.story-copy h2,.maker-copy h2{margin-bottom:20px;letter-spacing:.025em;font-size:clamp(1.75rem,3.4vw,2.5rem);line-height:1.5}.story-copy p:not(.eyebrow){font-size:1.125rem}.story-copy .text-link{margin-top:18px}.story-photo{grid-column:2;grid-row:1;margin:0;position:relative;min-width:0}.story-photo :global(picture){display:block;position:absolute;inset:0}.story-photo :global(img){width:100%;height:100%;object-fit:cover;object-position:center}.story-photo figcaption{display:none}
.journal-section{background:var(--paper)}.section-head h2{margin-bottom:20px}.journal-section .section-head{text-align:center}.journal-section .lead{margin-inline:auto;max-width:46em}.empty-state{background:var(--surface);max-width:800px;margin-inline:auto;padding:32px 40px;border-top:1px solid var(--line)}.empty-state h3{font-family:var(--serif);color:var(--ink);font-weight:500;margin-bottom:16px}.empty-state p{font-size:1.125rem}.empty-state .btn{margin-top:24px}.theme-action{margin-top:auto;padding-top:24px;font-size:1rem;text-decoration:underline;text-underline-offset:6px}.recommended{background:var(--surface)}
.maker-section{background:var(--paper);border-block:2px solid var(--white)}.maker-inner{grid-template-columns:1fr 1.12fr}.maker-copy{grid-column:2;grid-row:1;padding:48px clamp(32px,5.5vw,80px)}.maker-copy .text-link{margin-top:20px}.maker-profile{grid-column:1;grid-row:1;background:var(--surface);display:flex;align-items:center;justify-content:center;padding:48px;min-width:0}.maker-profile :global(picture){width:min(100%,360px)}.maker-profile :global(img){width:100%;height:auto;aspect-ratio:1;object-fit:cover}.maker-name{font-family:var(--serif);font-size:1.375rem;margin-top:24px}.maker-title{font-size:.9375rem;margin-top:8px}.title-part{display:inline-block}.title-explanation,.maker-location{font-size:.875rem;color:var(--muted);margin-top:8px}
.contact-section{background:var(--surface);text-align:center}.contact-section .lead{max-width:48em;margin-inline:auto}.contact-actions{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-top:32px}.mobile-break{display:none}
@media(max-width:1000px){.hero-copy,.story-copy,.maker-copy{padding-inline:32px}.hero .btn{min-width:0;width:100%}.maker-profile{padding:32px}}
@media(max-width:720px){.hero,.story-inner,.maker-inner{grid-template-columns:1fr}.hero-photo{grid-column:1;grid-row:1;aspect-ratio:4/3;min-height:0}.hero-copy{grid-column:1;grid-row:2;padding:32px 24px 40px;display:flex;flex-direction:column}.hero h1{font-size:clamp(1.875rem,8.8vw,2.5rem)}.hero .eyebrow{font-size:.8125rem;margin-bottom:16px}.hero .btn{order:3;width:100%;margin-top:24px;padding-inline:12px}.hero-copy>.eyebrow{order:1}.hero-copy>h1{order:2}.hero-description{order:4;margin-top:24px}.hero-photo :global(img){object-position:center 68%}.story-copy{grid-column:1;grid-row:1;padding:36px 24px}.story-photo{grid-column:1;grid-row:2;aspect-ratio:4/3}.story-copy h2,.maker-copy h2{font-size:1.875rem}.journal-section .section-head{text-align:left}.journal-section .lead{margin-inline:0}.empty-state{padding:26px 24px}.empty-state .btn{width:100%;padding-inline:12px}.maker-copy{grid-column:1;grid-row:2;padding:36px 24px}.maker-profile{grid-column:1;grid-row:1;padding:32px 24px}.maker-profile :global(picture){width:min(100%,280px)}.contact-section{text-align:left}.contact-actions{flex-direction:column;align-items:stretch}.mobile-break{display:block}.desktop-break{display:none}}
</style>
