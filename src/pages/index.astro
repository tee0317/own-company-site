---
import Layout from '../layouts/Layout.astro';
import TeaPhoto from '../components/TeaPhoto.astro';
import PostCard from '../components/PostCard.astro';
import {themes,SITE} from '../lib/site';
import {publishedPosts} from '../lib/posts';
const posts=await publishedPosts();
const activeThemes=themes.filter(t=>posts.some(p=>p.data.theme===t.id));
const featured=posts.filter(p=>p.data.featured).sort((a,b)=>a.data.featuredOrder-b.data.featuredOrder).slice(0,3);
---
<Layout title="カフェインを気遣う日も、好きな紅茶を。｜PJソクラテス">
<section class="hero">
 <div class="hero-copy">
  <p class="eyebrow">カフェインレス紅茶と、お茶時間</p>
  <h1>カフェインを<br/>気遣う日も、<br/>好きな紅茶を。</h1>

  <p class="hero-description">カフェインを気遣いながらも、<br class="desktop-break"/>お気に入りの香りと味わいを楽しめる紅茶で、<br class="desktop-break"/>自分のための、やさしい時間を。</p>
  <a class="btn" href="#guide">紅茶の困りごとから探す</a>

 </div>
 <figure class="hero-photo"><TeaPhoto name="紅茶をグラスに注ぐ手元.jpg" alt="グラスに注がれる琥珀色の紅茶" eager/><figcaption>好きな一杯と、自分のための時間。</figcaption></figure>
</section>
<section class="story-teaser">
 <div class="story-inner">
  <figure class="story-photo"><TeaPhoto name="白いカップの紅茶.jpg" alt="白いカップに入れた紅茶と、そばに置いたティーポット"/><figcaption>母の好きな紅茶から、始まりました。</figcaption></figure>
  <div class="story-copy">
   <p class="eyebrow">この一杯を探す理由</p>
   <h2>母の好きな時間を、<br/>少しでも長く。</h2>
   <p>子育てを支えてくれた、紅茶好きの母へ。自分の好きなものを楽しむ時間を。その思いから、カフェインレスのアイスティーを探しています。</p>
   <a class="text-link" href="/story/">母から始まった、この取り組み</a>
  </div>
 </div>
</section>
<section class="maker-section">
 <div class="maker-inner">
  <div class="maker-copy"><p class="eyebrow">作り手と、いまの取り組み</p><h2>家族の夏に似合う、<br/>一杯を探しています。</h2><p>母が好きな紅茶を、香りと味わいを大切に。家族で楽しめる、カフェインレスのアイスティーを探しています。</p><p class="maker-title">{SITE.title.split('・').map((part,index)=><span class="title-part">{index>0?'・':''}{part}</span>)}</p><p class="title-explanation">自分の活動を表すために名乗っている肩書です。</p><a class="text-link" href="/about/">作り手について</a></div>
  <figure class="maker-profile"><TeaPhoto name="作り手の土志田拓郎.jpg" alt="作り手の土志田拓郎"/><figcaption>{SITE.maker}</figcaption></figure>
 </div>
</section>
<section class="section journal-section" id="guide">
 <div class="wrap">
  <div class="section-head"><p class="eyebrow">TEA JOURNAL / 紅茶の読みもの</p><h2>好きな紅茶を、<br class="mobile-break"/>もっと自分らしく。</h2><p class="lead">自分に合う一杯を選ぶこと。おいしく淹れること。お茶のある時間を楽しむこと。<br class="desktop-break"/>気になったことを、ひとつずつ確かめる場所です。</p></div>
  {activeThemes.length>0?<div class="theme-grid">{activeThemes.map(t=><a class="theme-card" href={`/blog/${t.id}/`}><span class="number">{t.number}</span><h3>{t.title}</h3><p>{t.description}</p><span class="theme-action">このテーマの記事を読む</span></a>)}</div>:<div class="empty-state"><h3>確かめたことを、きちんと言葉に。</h3><p>紅茶の表示や味わい、淹れ方について、自分で試したことと資料から調べたことを分けながら、記事を準備しています。</p><p>「カフェインレスでも、好きな味は見つかる？」「アイスティーをおいしく淹れたい」。そんな気になることがあれば、ぜひお聞かせください。</p><a class="btn btn-outline" href="/contact/?kind=tea">紅茶について質問する</a></div>}
 </div>
</section>
{featured.length>0&&<section class="section recommended"><div class="wrap"><div class="section-head"><p class="eyebrow">SELECTED JOURNAL</p><h2>おすすめの記事</h2><p class="lead">好きな紅茶との付き合い方を考える、最初の読みものに。</p></div><div class="post-grid">{featured.map(post=><PostCard post={post}/>)}</div><a class="text-link" href="/blog/">紅茶の記事を読む</a></div></section>}

<section class="section contact-section"><div class="wrap"><p class="eyebrow">LET'S TALK / ひとつの質問から</p><h2>あなたの紅茶時間を、<br class="mobile-break"/>聞かせてください。</h2><p class="lead">いつもの一杯について気になること、試してみたい淹れ方、お茶時間の楽しみ方。<br class="desktop-break"/>紅茶の質問も、お店・団体からのご相談も、内容を確認して返信します。</p><div class="contact-actions"><a class="btn" href="/contact/?kind=tea">紅茶について質問する</a><a class="btn btn-outline" href="/contact/?kind=organization">お店・団体からのご相談</a></div></div></section>
</Layout>
<style>
.hero,.story-inner,.maker-inner{display:grid;max-width:1200px;margin-inline:auto}
.hero{grid-template-columns:53.6% 46.4%;min-height:440px;background:var(--paper)}
.hero-copy{grid-column:2;grid-row:1;padding:40px clamp(32px,5.8vw,72px);align-self:center;min-width:0;font-family:var(--serif)}
.hero .eyebrow{font-size:.875rem;line-height:1.5;margin-bottom:18px;letter-spacing:.1em}
.hero h1{font-size:clamp(2rem,4.3vw,3.25rem);line-height:1.28;letter-spacing:.055em}
.hero-description{font-size:1rem;line-height:1.8;color:var(--muted);margin-top:20px;max-width:27em}
.hero .btn{margin-top:26px;min-width:280px;font-family:var(--serif);letter-spacing:.04em}
.hero-photo{grid-column:1;grid-row:1;margin:0;min-width:0;position:relative;min-height:440px}.hero-photo :global(picture){position:absolute;inset:0;display:block}.hero-photo :global(img){width:100%;height:100%;object-fit:cover;object-position:center 64%}.hero-photo figcaption{display:none}
.story-teaser{border-block:2px solid var(--white);background:var(--surface)}.story-inner{grid-template-columns:45% 55%}
.story-copy{grid-column:1;grid-row:1;padding:28px clamp(32px,5.8vw,72px);align-self:center;min-width:0;font-family:var(--serif)}
.story-copy .eyebrow,.maker-copy .eyebrow{font-size:.8125rem;line-height:1.5;margin:0 0 12px;letter-spacing:.1em}
.story-copy h2,.maker-copy h2{margin-bottom:16px;letter-spacing:.03em;font-size:clamp(1.75rem,3.3vw,2.5rem);line-height:1.3}
.story-copy p:not(.eyebrow),.maker-copy>p:not(.eyebrow):not(.maker-title):not(.title-explanation){font-size:1rem;line-height:1.75;margin:0}
.story-copy .text-link{margin-top:10px;font-size:1rem;min-height:36px}
.story-photo{grid-column:2;grid-row:1;margin:0;position:relative;min-width:0;min-height:340px}.story-photo :global(picture){display:block;position:absolute;inset:0}.story-photo :global(img){width:100%;height:100%;object-fit:cover;object-position:center 62%}.story-photo figcaption{display:none}
.maker-section{background:var(--paper);border-bottom:2px solid var(--white)}.maker-inner{grid-template-columns:49.2% 50.8%}
.maker-copy{grid-column:2;grid-row:1;padding:24px clamp(32px,5.8vw,72px);align-self:center;min-width:0;font-family:var(--serif)}.maker-copy h2{font-size:clamp(1.75rem,3vw,2.25rem)}.maker-copy .text-link{margin-top:10px;font-size:1rem;min-height:36px}
.maker-profile{grid-column:1;grid-row:1;margin:0;min-width:0;position:relative;min-height:340px;overflow:hidden}.maker-profile :global(picture){position:absolute;inset:0;display:block}.maker-profile :global(img){width:100%;height:100%;object-fit:cover;object-position:center 40%}.maker-profile figcaption{position:absolute;left:24px;bottom:18px;background:var(--paper);padding:5px 12px;font-size:.8125rem;color:var(--ink);font-family:var(--serif)}
.maker-title{font-size:.8125rem;line-height:1.6;margin:12px 0 0}.title-part{display:inline-block}.title-explanation{font-size:.75rem;line-height:1.6;color:var(--muted);margin:2px 0 0}
.journal-section{background:var(--paper)}.section-head h2{margin-bottom:20px}.journal-section .section-head{text-align:center}.journal-section .lead{margin-inline:auto;max-width:46em}.empty-state{background:var(--surface);max-width:800px;margin-inline:auto;padding:32px 40px;border-top:1px solid var(--line)}.empty-state h3{font-family:var(--serif);color:var(--ink);font-weight:500;margin-bottom:16px}.empty-state p{font-size:1.125rem}.empty-state .btn{margin-top:24px}.theme-action{margin-top:auto;padding-top:24px;font-size:1rem;text-decoration:underline;text-underline-offset:6px}.recommended{background:var(--surface)}
.contact-section{background:var(--surface);text-align:center}.contact-section .lead{max-width:48em;margin-inline:auto}.contact-actions{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-top:32px}.mobile-break{display:none}
@media(max-width:1000px){.hero-copy,.story-copy,.maker-copy{padding-inline:32px}.hero .btn{min-width:0;width:100%}}
@media(max-width:720px){.hero,.story-inner,.maker-inner{grid-template-columns:1fr}.hero{min-height:0}.hero-photo{grid-column:1;grid-row:1;aspect-ratio:4/3;min-height:0}.hero-copy{grid-column:1;grid-row:2;padding:32px 24px 40px;display:flex;flex-direction:column}.hero h1{font-size:clamp(1.875rem,8.8vw,2.5rem);line-height:1.45}.hero .eyebrow{font-size:.8125rem;margin-bottom:16px}.hero .btn{order:3;width:100%;margin-top:24px;padding-inline:12px}.hero-copy>.eyebrow{order:1}.hero-copy>h1{order:2}.hero-description{order:4;font-size:1.125rem;line-height:1.8;margin-top:24px}.hero-photo :global(img){object-position:center 68%}.story-copy{grid-column:1;grid-row:1;padding:32px 24px}.story-photo{grid-column:1;grid-row:2;aspect-ratio:4/3;min-height:0}.story-copy h2,.maker-copy h2{font-size:1.875rem;line-height:1.4}.story-copy p:not(.eyebrow),.maker-copy>p:not(.eyebrow):not(.maker-title):not(.title-explanation){font-size:1.125rem;line-height:1.8}.story-copy .text-link,.maker-copy .text-link{min-height:48px}.maker-copy{grid-column:1;grid-row:2;padding:32px 24px}.maker-profile{grid-column:1;grid-row:1;min-height:0;aspect-ratio:4/3}.maker-title{font-size:.875rem}.title-explanation{font-size:.8125rem}.journal-section .section-head{text-align:left}.journal-section .lead{margin-inline:0}.empty-state{padding:26px 24px}.empty-state .btn{width:100%;padding-inline:12px}.contact-section{text-align:left}.contact-actions{flex-direction:column;align-items:stretch}.mobile-break{display:block}.desktop-break{display:none}}
</style>
