---
import Layout from '../layouts/Layout.astro';
import TeaPhoto from '../components/TeaPhoto.astro';
import '../styles/home.css';

const heroPhoto = '窓辺で紅茶を淹れる茶房の全景.jpg';
const places = [
  {
    photo: '施設の体験会の会場.jpg',
    alt: '大きな窓から光が入る、テーブルと椅子が並んだ会場',
    title: '施設の体験会で',
    text: '施設や地域の集まりに。簡単な体操やクイズ、紅茶の淹れ方体験を組み合わせたレクリエーションもご相談いただけます。',
  },
  {
    photo: '教室とサロンの会場.jpg',
    alt: '木の梁が見える会場で、ピアノのそばの演奏を聴く人たち',
    title: '教室・サロンで',
    text: 'ピアノ教室のレセプションパーティなど。20〜40名様の会も、会場や提供方法に合わせてご相談いただけます。',
  },
  {
    photo: '百貨店の売場イメージ.jpg',
    alt: '木目のカウンターが並ぶ百貨店の売場イメージ',
    title: 'お店の一角で',
    text: '都内の百貨店で、店頭試飲会を実施。平日2時間の売上は、別の平日の同じ時間帯と比べて約1.5倍でした。',
  },
  {
    photo: '家族のお茶会のテーブル.jpg',
    alt: '窓辺の木のテーブルにカップ、ポット、お菓子が並ぶ様子',
    title: '家族の集まりに',
    text: '特別な記念日や、久しぶりに顔をそろえる日に。みなさまの会話を保ったまま、必要なときに気づき場を盛り上げます。',
  },
];
---
<Layout
  title="出張ティーソムリエ｜千葉から、カフェインレス紅茶のお茶会へ｜プロジェクトソクラテス"
  description="千葉を拠点に、茶葉と道具を持って伺う出張ティーソムリエ。家族の集まりや施設の体験会、教室・サロン、お店で、カフェインレスの紅茶を目の前でお淹れします。"
  overlayHeader
  image={heroPhoto}
>
  <div class="home">
    <section class="h-hero" aria-labelledby="home-title">
      <div class="h-hero-photo">
        <TeaPhoto name={heroPhoto} alt="窓辺で紅茶を注ぐ手元とテーブルに並ぶカップ" sizes="100vw" eager />
      </div>
      <div class="h-hero-copy">
        <h1 id="home-title">いつも気を配る<span>あなたにも、</span><br />ゆっくり一杯を。</h1>
        <div class="h-hero-text">
          <p>千葉を拠点に、お子さんでも楽しめる上品な空間を提供します。</p>
          <p>なぜなら私は、シングルファザーとして子を育てる父であり、五感を満たす最高品質のアイテムを扱うブランドの運営をしているからです。</p>
        </div>
        <a class="h-btn h-btn-primary" href="/contact/">出張のお茶会を相談する</a>
      </div>
    </section>

    <section class="h-section" aria-labelledby="home-story-heading">
      <div class="h-wrap h-split">
        <div class="h-story-copy">
          <h2 id="home-story-heading">母にも、<br />もてなされる時間を。</h2>
          <p>娘との暮らしを支える母に、好きな紅茶を孫と楽しむ時間を贈りたい。</p>
          <div class="h-links">
            <a href="/story/">母から始まった物語を読む</a>
          </div>
        </div>
        <div class="h-feature-photo">
          <TeaPhoto name="カップを手に話す二人の手元.jpg" alt="紅茶のカップを手に向かい合う二人の手元のイメージ" />
        </div>
      </div>
    </section>

    <section class="h-section h-places" id="places" aria-labelledby="places-heading">
      <div class="h-wrap">
        <h2 id="places-heading">たとえば、こんな場所で。</h2>
        <ul class="h-place-grid">
          {places.map(({ photo, alt, title, text }) => (
            <li class="h-place">
              <h3>{title}</h3>
              <TeaPhoto name={photo} alt={alt} sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 25vw" />
              <p>{text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="h-section h-carry" aria-labelledby="carry-heading">
      <div class="h-wrap h-split">
        <div class="h-carry-copy">
          <h2 id="carry-heading">茶葉と道具を持って、<br />伺います。</h2>
          <p>必要な道具はございません、手ぶらでOKです。</p>
        </div>
        <div class="h-feature-photo">
          <TeaPhoto name="道具を収めた木の茶箱.jpg" alt="ポットやカップ、茶葉の小瓶を収めた木の茶箱" />
        </div>
      </div>
    </section>

    <section class="h-section h-closing" aria-labelledby="closing-heading">
      <div class="h-wrap">
        <h2 id="closing-heading">あなたの場所でも、<br />できるかもしれません。</h2>
        <p>日にちや人数は未定でも大丈夫です。場所と、どなたと過ごす時間かを、決まっている範囲でお聞かせください。</p>
        <a class="h-btn" href="/contact/">出張のお茶会を相談する</a>
      </div>
    </section>
  </div>
</Layout>
