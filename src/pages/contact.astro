---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import PageLinks from '../components/PageLinks.astro';
import {formUrl} from '../lib/site';
const url=formUrl();
---
<Layout title="問い合わせ｜プロジェクトソクラテス" description="紅茶の質問、お店・団体からのご相談は専用フォームへ。内容を確認して返信します。" breadcrumbs={[{name:'問い合わせ'}]}>
<div class="subpage">
 <PageIntro eyebrow="LET’S TALK / お問い合わせ" title="紅茶のこと、聞かせてください。" lead="選び方や淹れ方で気になること、いつものお茶時間の楽しみ方。ひとつの質問から、紅茶の話をしてみませんか。" photo="本と紅茶のある静かな時間.jpg" focus="28% 50%" alt="本と紅茶のある時間のイメージ"/>
 <div class="wrap section contact-layout"><aside class="contact-guide"><p class="eyebrow">フォームのご案内</p><h2>小さな疑問も、<br/>ご相談も。</h2><h3>紅茶についての質問</h3><p>カフェインレス紅茶の選び方や淹れ方など、気になっていることをお寄せください。</p><h3>お店・団体からのご相談</h3><p>地域・時期・人数は、決まっている範囲でお聞かせください。任意の項目です。内容を確認して返信します。</p><h3>送信のあと</h3><ol><li>種別と内容を入力してください。</li><li>情報の取り扱いをご確認のうえ、同意して送信してください。</li><li>送信が完了すると、フォーム内に完了表示が出ます。</li></ol><p>自動返信メールはお送りしていません。内容を確認して返信します。</p><a class="text-link" href="/privacy/">プライバシーポリシー</a></aside><section class="contact-panel" aria-label="問い合わせフォーム"><h2>お問い合わせフォーム</h2><p>お名前、返信先メールアドレス、内容をご記入ください。</p>{url?<><iframe id="contact-form" src={url} title="問い合わせフォーム" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe><p class="contact-fallback">フォームが表示されない場合は、<a id="form-link" href={url} target="_blank" rel="noopener noreferrer">同じフォームを別画面で開く</a>こともできます。</p></>:<div class="note"><p>問い合わせフォームは現在準備中です。</p></div>}</section></div>
 <PageLinks heading="この場所について、もう少し。" links={[{eyebrow:'OUR STORY',title:'母から始まった、この取り組み。',description:'好きな紅茶を楽しむ時間があってほしい。その思いから、一杯を探しています。',url:'/story/',label:'はじまりの物語を読む'},{eyebrow:'THE MAKER',title:'作り手と、いまの取り組み。',description:'佐倉・千葉を拠点に、母への感謝を日々の取り組みへつなげています。',url:'/about/',label:'作り手について読む'}]}/>
</div></Layout>
<script>const kind=new URLSearchParams(location.search).get('kind');if(kind&&['tea','organization','other'].includes(kind)){for(const element of [document.getElementById('contact-form'),document.getElementById('form-link')]){if(element){const attribute=element.tagName==='IFRAME'?'src':'href';const url=new URL(element.getAttribute(attribute)!);url.searchParams.set('kind',kind);element.setAttribute(attribute,url.href);}}}</script>
