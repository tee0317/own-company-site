---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import PageLinks from '../components/PageLinks.astro';
import { formUrl } from '../lib/site';
const url = formUrl();
---
<Layout title="ご相談｜出張ティーソムリエ｜プロジェクトソクラテス" description="出張で紅茶を淹れるご相談、紅茶についての質問は専用フォームへ。日にちや人数が決まっていなくても大丈夫です。" breadcrumbs={[{ name: 'ご相談' }]}>
  <div class="subpage">
    <PageIntro
      eyebrow="LET’S TALK / ご相談"
      title="うちでもできる？を、気軽に。"
      titleLines={['うちでもできる？', 'を、気軽に。']}
      lead="どんな場所で、どなたに飲んでほしいか。日にちや人数が決まっていなくても大丈夫です。紅茶についての質問も、こちらから。"
      photo="カップを手に話す二人の手元.jpg"
      focus="28% 50%"
      alt="紅茶のカップを手に向かい合う二人の手元"
    />
    <div class="narrow section">
      <section class="contact-panel" aria-label="問い合わせフォーム">
        <h2>お問い合わせフォーム</h2>
        {url ? (
          <>
            <iframe id="contact-form" src={url} title="問い合わせフォーム" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
            <p class="contact-fallback">フォームが表示されない場合は、<a id="form-link" href={url} target="_blank" rel="noopener noreferrer">同じフォームを別画面で開く</a>こともできます。</p>
          </>
        ) : <div class="note"><p>問い合わせフォームは現在準備中です。</p></div>}
        <p class="contact-privacy"><a class="text-link" href="/privacy/">プライバシーポリシー</a></p>
      </section>
    </div>
    <PageLinks heading="この場所について、もう少し。" links={[
      { eyebrow: 'OUR STORY', title: '母から始まった、この取り組み。', description: '好きな紅茶を楽しむ時間があってほしい。その思いから、一杯を探しています。', url: '/story/', label: 'はじまりの物語を読む' },
      { eyebrow: 'THE MAKER', title: '作り手と、いまの取り組み。', description: '千葉を拠点に、母への感謝を日々の取り組みへつなげています。', url: '/about/', label: '作り手について読む' },
    ]} />
  </div>
</Layout>
<script>
  const kind = new URLSearchParams(location.search).get('kind');
  if (kind && ['tea', 'organization', 'other'].includes(kind)) {
    for (const element of [document.getElementById('contact-form'), document.getElementById('form-link')]) {
      if (element) {
        const attribute = element.tagName === 'IFRAME' ? 'src' : 'href';
        const url = new URL(element.getAttribute(attribute)!);
        url.searchParams.set('kind', kind);
        element.setAttribute(attribute, url.href);
      }
    }
  }
</script>
