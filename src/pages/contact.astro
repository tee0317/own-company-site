---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
const lineUrl = "https://line.me/R/ti/p/@212unaej";
---

<Layout
  title="お問い合わせ｜プロジェクトソクラテス（PJSocrates）"
  description="プロジェクトソクラテス（PJSocrates）へのお問い合わせはLINE公式アカウントから承っております。"
  showBreadcrumb
>
  <Fragment slot="breadcrumb">
    <div class="breadcrumb">
      <div class="wrap"><a href={base}>ホーム</a> › お問い合わせ</div>
    </div>
  </Fragment>

  <section class="page-head">
    <div class="wrap">
      <h1>お問い合わせ</h1>
      <p class="page-intro">
        商品に関するご質問・お問い合わせは、LINE公式アカウントにて承っております。
      </p>
    </div>
  </section>

  <section class="contact-body">
    <div class="wrap">
      <div class="qr-card">
        <img
          src={`${base}images/contact/line-qr.png`}
          alt="LINE公式アカウント 友だち追加用QRコード"
          class="qr-image"
        />
        <p class="qr-caption">QRコードを読み取って、友だち追加してください</p>
        <a class="btn btn-accent" href={lineUrl} target="_blank" rel="noopener">
          友だち追加はこちら
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding: 56px 0 40px;
  }
  .page-head h1 {
    font-size: 30px;
    display: inline-block;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 20px;
  }
  .page-intro {
    font-size: 21px;
    color: var(--ink-soft);
    margin: 0;
  }

  .contact-body {
    padding: 0 0 80px;
  }
  .qr-card {
    max-width: 360px;
    margin: 0 auto;
    padding: 40px 32px;
    border: 1px solid var(--line);
    border-radius: 6px;
    text-align: center;
  }
  .qr-image {
    width: 220px;
    height: 220px;
    margin: 0 auto 20px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .qr-caption {
    margin: 0 0 24px;
    font-size: 16px;
    color: var(--ink-soft);
  }
</style>
