---
import type {CollectionEntry} from 'astro:content';
import TeaPhoto from './TeaPhoto.astro';
import {themes} from '../lib/site';
import {dateLabel} from '../../scripts/lib/publication.mjs';
const {post}=Astro.props as {post:CollectionEntry<'blog'>};
const theme=themes.find(t=>t.id===post.data.theme)!;
---
<article class="post-card"><a class="post-card-link" href={`/blog/${post.id}/`}>{post.data.heroImage&&<div class="post-image"><TeaPhoto name={post.data.heroImage} alt={post.data.heroAlt!}/></div>}<div class="post-copy"><p class="eyebrow">{theme.title} / COLUMN</p><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="post-meta"><time datetime={post.data.publishedAt}>{dateLabel(post.data.publishedAt)}</time><span class="card-action">続きを読む</span></div></div></a></article>
