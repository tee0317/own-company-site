---
interface Props { heading?:string; links:{eyebrow:string;title:string;description:string;url:string;label:string}[]; }
const {heading='この先も、一杯を探しながら。',links}=Astro.props;
---
<section class="page-links section" aria-label="次のページへ">
 <div class="wrap"><p class="eyebrow">EXPLORE PROJECT SOCRATES</p><h2>{heading}</h2>
 <div class="page-links-grid">{links.map(link=><a class="page-link-card" href={link.url}><p class="eyebrow">{link.eyebrow}</p><h3>{link.title}</h3><p>{link.description}</p><span class="page-link-label">{link.label}</span></a>)}</div></div>
</section>
